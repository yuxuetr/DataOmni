# 默认所有文本文件检出和提交均统一使用 LF，消除跨平台 CRLF/LF 冲突
* text=auto eol=lf

# 源码与配置文件统一 LF
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell 脚本强制 LF
*.sh text eol=lf

# Windows 批处理脚本必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件保持原样，不进行换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary
*.dylib binary
*.dll binary
*.so binary
*.exe binary
