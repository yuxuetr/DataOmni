{
  "why": "命令行给 Agent 只放行读语句（rfcs/agent-cli.md §5.2）。判定在 src-tauri/src/services/read_only_gate.rs，它对每一种可能的词法（反斜杠转义、# 注释、嵌套注释、美元引号、反引号、方括号、Oracle q 引号、MySQL 的 -- 规则）各扫一遍，任何一种看出问题就拒绝。allow 里的每一条，界面的 src/utils/statementRisk.ts 也必须判成 read：两边分叉说明有一边错了。",
  "allow": [
    { "sql": "SELECT 1", "dialect": "postgresql" },
    { "sql": "select * from users where name = 'O''Brien'", "dialect": "mysql" },
    { "sql": "-- 注释\nSELECT id FROM t", "dialect": "postgresql" },
    { "sql": "/* c */ SELECT 1;", "dialect": "postgresql" },
    { "sql": "SELECT 1;  -- end", "dialect": "mysql" },
    { "sql": "WITH x AS (SELECT 1 AS a) SELECT a FROM x", "dialect": "postgresql" },
    { "sql": "(SELECT 1) UNION (SELECT 2)", "dialect": "mysql" },
    { "sql": "SHOW TABLES", "dialect": "mysql" },
    { "sql": "SHOW CREATE TABLE t", "dialect": "mysql" },
    { "sql": "DESCRIBE t", "dialect": "mysql" },
    { "sql": "EXPLAIN SELECT * FROM t WHERE id = 1", "dialect": "postgresql" },
    { "sql": "VALUES (1), (2)", "dialect": "postgresql" },
    { "sql": "TABLE t", "dialect": "postgresql" },
    { "sql": "SELECT 'DELETE FROM t' AS s", "dialect": "postgresql" },
    { "sql": "SELECT \"update\" FROM t", "dialect": "postgresql" },
    { "sql": "SELECT `order`, `key` FROM t", "dialect": "mysql" },
    { "sql": "SELECT replace(name, 'a', 'b') FROM t", "dialect": "postgresql" },
    { "sql": "SELECT * FROM emp START WITH mgr IS NULL CONNECT BY PRIOR id = mgr", "dialect": "oracle" },
    { "sql": "SELECT name FROM t ORDER BY name DESC", "dialect": "sqlite" },
    { "sql": "FROM t", "dialect": "duckdb" },
    { "sql": "SUMMARIZE t", "dialect": "duckdb" },
    { "sql": "SELECT count(*) FROM system.tables", "dialect": "clickhouse" },
    { "sql": "SELECT a.id, b.v FROM a JOIN b ON a.id = b.id WHERE b.v > 10 LIMIT 5", "dialect": "mysql" }
  ],
  "deny": [
    { "sql": "", "why": "空的" },
    { "sql": "DELETE FROM t", "why": "写" },
    { "sql": "INSERT INTO t VALUES (1)", "why": "写" },
    { "sql": "UPDATE t SET a = 1", "why": "写" },
    { "sql": "REPLACE INTO t VALUES (1)", "why": "MySQL 的写" },
    { "sql": "MERGE INTO t USING s ON (1 = 1) WHEN MATCHED THEN DELETE", "why": "写" },
    { "sql": "DROP TABLE t", "why": "DDL；MySQL、Oracle 的只读事务挡不住（E3）" },
    { "sql": "CREATE TABLE t (a int)", "why": "DDL；同上" },
    { "sql": "ALTER TABLE t ADD c int", "why": "DDL" },
    { "sql": "TRUNCATE t", "why": "DDL" },
    { "sql": "GRANT SELECT ON t TO u", "why": "权限" },
    { "sql": "LOCK TABLE t", "why": "锁" },
    { "sql": "BEGIN", "why": "事务控制" },
    { "sql": "SET TRANSACTION READ WRITE", "why": "事务第一条就改回读写，PostgreSQL 会放行（E5）" },
    { "sql": "CALL p()", "why": "存储过程什么都能做" },
    { "sql": "DO $$ BEGIN DELETE FROM t; END $$", "why": "匿名块" },
    { "sql": "PRAGMA journal_mode = DELETE", "why": "SQLite 的 PRAGMA 能改库" },
    { "sql": "ATTACH 'x.db' AS x", "why": "SQLite 只读打开后仍能写出新文件（E4）" },
    { "sql": "VACUUM INTO 'copy.db'", "why": "同上" },
    { "sql": "COPY t TO '/tmp/x.csv'", "why": "写文件" },
    { "sql": "INSTALL httpfs", "why": "DuckDB 扩展" },
    { "sql": "SELECT 1; DELETE FROM t", "why": "多条语句" },
    { "sql": "SELECT 1; COMMIT", "why": "提交掉只读事务之后的语句就不受约束了" },
    { "sql": "SHOW TABLES; DROP TABLE t", "why": "多条语句" },
    { "sql": "WITH d AS (DELETE FROM t RETURNING *) SELECT * FROM d", "why": "改数据的 CTE" },
    { "sql": "SELECT * INTO t2 FROM t", "why": "SELECT INTO 建表" },
    { "sql": "SELECT 1 INTO OUTFILE '/tmp/x'", "why": "写文件" },
    { "sql": "SELECT * FROM t FOR UPDATE", "why": "加锁" },
    { "sql": "EXPLAIN ANALYZE DELETE FROM t", "why": "ANALYZE 会真的执行" },
    { "sql": "EXPLAIN (ANALYZE) SELECT 1", "why": "同上，选项在括号里" },
    { "sql": "SELECT pg_terminate_backend(123)", "why": "只读事务挡不住（E5）" },
    { "sql": "SELECT \"pg_terminate_backend\"(123)", "why": "带引号的函数名" },
    { "sql": "SELECT pg_catalog.pg_terminate_backend(123)", "why": "带模式名" },
    { "sql": "SELECT pg_advisory_lock(1)", "why": "会话级的锁" },
    { "sql": "SELECT get_lock('x', 0)", "why": "MySQL 只读事务挡不住（E3）" },
    { "sql": "SELECT nextval('s')", "why": "改序列" },
    { "sql": "SELECT query_to_xml('select 1', true, true, '')", "why": "执行字符串里的语句" },
    { "sql": "SELECT * FROM read_text('/etc/passwd')", "why": "DuckDB 读本机文件（E4）" },
    { "sql": "SELECT * FROM url('http://x', 'CSV', 'a String')", "why": "ClickHouse 访问网络" },
    { "sql": "/*! DELETE FROM t */ SELECT 1", "why": "MySQL 会执行 /*! */ 里的内容" },
    { "sql": "SELECT 'x\\'; COMMIT; DELETE FROM t; --'", "why": "不认反斜杠转义的库（PostgreSQL）会把这当成三条语句" },
    { "sql": "SELECT E'\\'', 'x\\'; COMMIT; DELETE FROM t; --'", "why": "PostgreSQL 只在 E'' 里认反斜杠" },
    { "sql": "SELECT 1 --1; DELETE FROM t", "why": "MySQL 的 -- 后面要有空白才是注释" },
    { "sql": "SELECT 1 /* /* */ ; DELETE FROM t */", "why": "不支持嵌套注释的库在第一个 */ 就结束注释" },
    { "sql": "SELECT [a'b] ; DELETE FROM t; --'", "why": "SQLite 的方括号标识符" },
    { "sql": "SELECT q'[x']' ; DELETE FROM t; --'", "why": "Oracle 的 q 引号" },
    { "sql": "SELECT $$'$$; DELETE FROM t; --'", "why": "美元引号：不认它的规矩会把后面当成字符串" },
    { "sql": "SELECT 1 # '\n; DELETE FROM t; -- '", "why": "MySQL 的 # 注释" },
    { "sql": "SELECT `a'b` ; DELETE FROM t; --'", "why": "反引号标识符" },
    { "sql": "SELECT \"a\\\"\" ; DELETE FROM t; --\"", "why": "MySQL 的双引号字符串也认反斜杠" },
    { "sql": "SELECT 'unterminated", "why": "引号没闭合" }
  ]
}
