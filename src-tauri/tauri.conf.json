{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataOmni",
  "version": "0.6.1",
  "identifier": "com.dataomni.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DataOmni",
        "width": 1600,
        "height": 1200,
        "center": true,
        "titleBarStyle": "Transparent",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for relational databases, MongoDB, Redis, Neo4j and Elasticsearch",
    "longDescription": "Browse schemas, edit table data, run queries and export results for MySQL, PostgreSQL, SQLite, SQL Server, Oracle, DuckDB and ClickHouse, with dedicated workspaces for MongoDB, Redis, Neo4j and Elasticsearch. Passwords are kept in the system keychain, never in plain text on disk.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ca-certificates"]
      },
      "rpm": {
        "depends": ["ca-certificates"]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
