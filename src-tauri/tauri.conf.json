{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataOmni",
  "version": "0.1.0",
  "identifier": "com.dataomni.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DataOmni",
        "width": 1600,
        "height": 1200,
        "center": true,
        "titleBarStyle": "Transparent",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
