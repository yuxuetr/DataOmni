// Generated by DataOmni from fixture.
// Review before use: relation names and field names are derived from the database.
// - users.session_length: type "geography" has no mapping; check this field by hand
// - audit_log: marked @@ignore, the table has no primary key or unique constraint
// - orders: relation fk_orders_coupon not generated, coupons is not in the selection

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Users {
  id             Int                       @id @default(autoincrement())
  email          String                    @unique @db.NVarChar(120)
  displayName    String?                   @map("display_name") @db.NVarChar(Max)
  createdAt      DateTime                  @default(now()) @map("created_at")
  isActive       Boolean                   @default(true) @map("is_active")
  settings       String?                   @db.NVarChar(Max)
  externalId     String?                   @map("external_id") @db.UniqueIdentifier
  avatar         Bytes?                    @db.VarBinary(Max)
  birthday       DateTime?                 @db.Date
  sessionLength  Unsupported("geography")? @map("session_length")
  userProfiles   UserProfiles?
  ordersByBuyer  Orders[]                  @relation("OrdersBuyer")
  ordersBySeller Orders[]                  @relation("OrdersSeller")
  c2faCodes      T2faCodes[]

  @@map("users")
}

model UserProfiles {
  userId Int     @id @map("user_id")
  bio    String? @db.NVarChar(Max)
  user   Users   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_profiles")
}

model Categories {
  id                 Int          @id @default(autoincrement())
  parentId           Int?         @map("parent_id")
  name               String       @db.NVarChar(120)
  parent             Categories?  @relation("CategoriesParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoriesByParent Categories[] @relation("CategoriesParent")
  products           Products[]

  @@map("categories")
}

model Orders {
  id           BigInt       @id @default(autoincrement())
  buyerId      Int          @map("buyer_id")
  sellerId     Int?         @map("seller_id")
  couponId     Int?         @map("coupon_id")
  total        Decimal      @default(0) @db.Decimal(10, 2)
  status       String       @default("new") @db.NVarChar(120)
  type         String?      @db.NVarChar(120)
  /// Computed by the database; do not write it.
  totalWithTax Decimal?     @map("total_with_tax") @db.Decimal(10, 2)
  buyer        Users        @relation("OrdersBuyer", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller       Users?       @relation("OrdersSeller", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems   OrderItems[]

  @@map("orders")
}

model Products {
  sku        String       @db.NVarChar(120)
  region     String       @db.NVarChar(120)
  categoryId Int?         @map("category_id")
  price      Float?
  category   Categories?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems OrderItems[]

  @@id([sku, region])
  @@map("products")
}

model OrderItems {
  orderId  BigInt   @map("order_id")
  sku      String   @db.NVarChar(120)
  region   String   @db.NVarChar(120)
  qty      Int      @default(1)
  order    Orders   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products Products @relation(fields: [sku, region], references: [sku, region], onDelete: NoAction, onUpdate: NoAction)

  @@id([orderId, sku, region])
  @@map("order_items")
}

/// The underlying table has no primary key or unique constraint, so Prisma Client cannot use it.
model AuditLog {
  at      DateTime?
  message String?   @db.NVarChar(Max)

  @@map("audit_log")
  @@ignore
}

model T2faCodes {
  id    Int     @id @default(autoincrement())
  class String? @db.NVarChar(120)
  user  Int?
  users Users?  @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("2fa codes")
}
